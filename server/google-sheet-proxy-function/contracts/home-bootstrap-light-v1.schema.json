{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golfjoin.local/contracts/home-bootstrap-light-v1.schema.json",
  "title": "GolfJoin public home bootstrap light",
  "type": "object",
  "required": [
    "ok",
    "serverTime",
    "updatedAt",
    "newScheduleSummaries",
    "participantSummaries",
    "displayRules",
    "wishTargetKeys",
    "memberBasic",
    "warnings"
  ],
  "properties": {
    "ok": { "type": "boolean" },
    "serverTime": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "minLength": 1 },
    "newScheduleSummaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/newSchedule" }
    },
    "participantSummaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/participantSummary" }
    },
    "displayRules": { "type": "array" },
    "wishTargetKeys": { "type": "array" },
    "memberBasic": {
      "type": "object",
      "required": ["hasMember"],
      "properties": {
        "hasMember": { "type": "boolean" }
      }
    },
    "warnings": { "type": "array" }
  },
  "$defs": {
    "preview": {
      "type": "object",
      "required": [
        "displayName",
        "gender",
        "ageDisplay",
        "profession",
        "level",
        "styles",
        "memberPreferences",
        "iconSeed",
        "companionGroup"
      ],
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "gender": { "type": "string", "minLength": 1 },
        "ageDisplay": { "type": "string" },
        "profession": { "type": "string" },
        "level": { "type": "string" },
        "styles": { "type": "array", "items": { "type": "string" } },
        "memberPreferences": { "type": "array", "items": { "type": "string" } },
        "iconSeed": { "type": "string", "pattern": "^preview_[a-f0-9]{20}$" },
        "companionGroup": { "type": "string" }
      }
    },
    "newSchedule": {
      "type": "object",
      "required": [
        "scheduleId",
        "applicationId",
        "targetType",
        "erpProductId",
        "erpEventSeq",
        "title",
        "departureDate",
        "returnDate",
        "price",
        "creatorPreview",
        "participantsPreview",
        "confirmedCount",
        "remainingSlots",
        "approvalStatus",
        "displayStatus"
      ],
      "properties": {
        "scheduleId": { "type": "string", "minLength": 1 },
        "applicationId": { "type": "string", "minLength": 1 },
        "targetType": { "const": "new_schedule" },
        "erpProductId": { "type": "string", "pattern": "^\\d+$" },
        "erpEventSeq": { "type": "string", "pattern": "^\\d+$" },
        "productFamilyId": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "departureDate": { "type": "string", "format": "date" },
        "returnDate": { "type": "string", "format": "date" },
        "price": { "type": ["string", "number"] },
        "creatorPreview": { "$ref": "#/$defs/preview" },
        "participantsPreview": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/preview" }
        },
        "confirmedCount": { "type": "integer", "minimum": 1 },
        "remainingSlots": { "type": "integer", "minimum": 0 },
        "approvalStatus": { "type": "string", "minLength": 1 },
        "displayStatus": { "type": "string", "minLength": 1 }
      }
    },
    "participantSummary": {
      "type": "object",
      "required": [
        "targetType",
        "targetScheduleId",
        "targetApplicationId",
        "erpProductId",
        "erpEventSeq",
        "capacity",
        "confirmedCount",
        "remainingSlots",
        "maleCount",
        "femaleCount",
        "participantsPreview"
      ],
      "properties": {
        "targetType": { "type": "string", "enum": ["new_schedule", "recommended_schedule"] },
        "targetScheduleId": { "type": "string" },
        "targetApplicationId": { "type": "string" },
        "erpProductId": { "type": "string", "pattern": "^\\d+$" },
        "erpEventSeq": { "type": "string", "pattern": "^\\d+$" },
        "capacity": { "type": "integer", "minimum": 1 },
        "confirmedCount": { "type": "integer", "minimum": 0 },
        "remainingSlots": { "type": "integer", "minimum": 0 },
        "maleCount": { "type": "integer", "minimum": 0 },
        "femaleCount": { "type": "integer", "minimum": 0 },
        "participantsPreview": {
          "type": "array",
          "maxItems": 40,
          "items": { "$ref": "#/$defs/preview" }
        },
        "lastAppliedAt": { "type": "string" }
      }
    }
  }
}
