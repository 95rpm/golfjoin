{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golfjoin.local/contracts/product-availability-index-v1.schema.json",
  "title": "GolfJoin product availability release index v1",
  "type": "object",
  "required": [
    "schema",
    "generatedAt",
    "availabilityRevision",
    "minimumAdvanceDays",
    "bookableFrom",
    "productCount",
    "items"
  ],
  "properties": {
    "schema": { "const": "secret-golf-join-product-availability-index-v1" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "availabilityRevision": { "type": "string", "pattern": "^gpa_[a-f0-9]{24}$" },
    "minimumAdvanceDays": { "type": "integer", "minimum": 0 },
    "bookableFrom": { "type": "string", "format": "date" },
    "productCount": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schema", "availabilityRevision", "goodSeq", "count", "events"],
        "properties": {
          "schema": { "const": "secret-golf-join-product-availability-v1" },
          "availabilityRevision": { "type": "string", "pattern": "^gpa_[a-f0-9]{24}$" },
          "goodSeq": { "type": "string", "pattern": "^\\d+$" },
          "count": { "type": "integer", "minimum": 0 },
          "events": { "type": "array" }
        }
      }
    }
  }
}
