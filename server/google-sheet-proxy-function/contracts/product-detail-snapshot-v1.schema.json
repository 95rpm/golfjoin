{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golfjoin.local/contracts/product-detail-snapshot-v1.schema.json",
  "title": "Secret Golf Join product detail snapshot v1",
  "type": "object",
  "required": [
    "schema",
    "generatedAt",
    "detailRevision",
    "goodSeq",
    "eventSeq",
    "erpProductId",
    "erpEventSeq",
    "title",
    "departureDate",
    "returnDate",
    "price",
    "detailStatus",
    "sectionStatus",
    "flight",
    "includes",
    "excludes",
    "notes",
    "schedule",
    "slides",
    "introImages",
    "sourceUrl",
    "source",
    "warnings"
  ],
  "properties": {
    "schema": { "const": "secret-golf-join-product-detail-v1" },
    "generatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "detailRevision": { "type": "string", "pattern": "^gpd_[a-f0-9]{24}$" },
    "goodSeq": { "type": "string", "pattern": "^\\d+$" },
    "eventSeq": { "type": "string", "pattern": "^\\d+$" },
    "erpProductId": { "type": "string", "pattern": "^\\d+$" },
    "erpEventSeq": { "type": "string", "pattern": "^\\d+$" },
    "goodTransportSeq": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "detailTitleCopy": { "type": "string" },
    "goodDescription": { "type": "string" },
    "departureDate": { "type": "string", "format": "date" },
    "returnDate": { "type": "string", "format": "date" },
    "duration": { "type": "string" },
    "price": { "type": "number", "minimum": 0 },
    "adultPrice": { "type": "number", "minimum": 0 },
    "childPrice": { "type": "number", "minimum": 0 },
    "infantPrice": { "type": "number", "minimum": 0 },
    "oilPrice": { "type": "number", "minimum": 0 },
    "heroImage": { "type": "string", "pattern": "^https?://" },
    "detailStatus": { "type": "string", "enum": ["ready", "partial", "unavailable"] },
    "sectionStatus": {
      "type": "object",
      "required": ["includes", "excludes", "notes", "schedule", "images"],
      "properties": {
        "includes": { "$ref": "#/$defs/sectionState" },
        "excludes": { "$ref": "#/$defs/sectionState" },
        "notes": { "$ref": "#/$defs/sectionState" },
        "schedule": { "$ref": "#/$defs/sectionState" },
        "images": { "$ref": "#/$defs/sectionState" }
      }
    },
    "flight": { "$ref": "#/$defs/flight" },
    "includes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "excludes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "notes": { "type": "array", "items": { "$ref": "#/$defs/note" } },
    "schedule": { "type": "array", "items": { "$ref": "#/$defs/scheduleDay" } },
    "slides": { "type": "array", "items": { "$ref": "#/$defs/imageUrl" } },
    "introImages": { "type": "array", "items": { "$ref": "#/$defs/imageUrl" } },
    "sourceUrl": { "type": "string", "pattern": "^https://(?:www\\.|m\\.)?secret-tour\\.com/goods/goods_view\\?" },
    "source": { "const": "secret-tour-goods-view" },
    "warnings": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_.-]+$" } }
  },
  "$defs": {
    "sectionState": {
      "type": "string",
      "enum": ["available", "empty", "unavailable"]
    },
    "imageUrl": {
      "type": "string",
      "pattern": "^https?://"
    },
    "note": {
      "type": "object",
      "required": ["text", "source"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "meal": {
      "type": "object",
      "required": ["label", "menu"],
      "properties": {
        "label": { "type": "string" },
        "menu": { "type": "string" }
      }
    },
    "scheduleExtra": {
      "type": "object",
      "required": ["hotel", "meals"],
      "properties": {
        "hotel": { "type": "string" },
        "meals": { "type": "array", "items": { "$ref": "#/$defs/meal" } }
      }
    },
    "scheduleDay": {
      "type": "object",
      "required": ["day", "dateText", "content", "rawText", "extra"],
      "properties": {
        "day": { "type": "string", "minLength": 1 },
        "dateText": { "type": "string" },
        "content": { "type": "string" },
        "rawText": { "type": "string" },
        "extra": { "$ref": "#/$defs/scheduleExtra" }
      }
    },
    "flightItem": {
      "type": "object",
      "required": ["label", "airline", "code", "fromDate", "fromTime", "toDate", "toTime", "rawText"],
      "properties": {
        "label": { "type": "string", "enum": ["출발", "도착"] },
        "airline": { "type": "string" },
        "code": { "type": "string" },
        "fromDate": { "type": "string", "format": "date" },
        "fromTime": { "type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$" },
        "toDate": { "type": "string", "format": "date" },
        "toTime": { "type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$" },
        "rawText": { "type": "string" }
      }
    },
    "flight": {
      "type": "object",
      "required": ["state", "packType", "airline", "departureAirport", "arrivalAirport", "items"],
      "properties": {
        "state": { "type": "string", "enum": ["loaded", "not_required", "partial", "unavailable"] },
        "packType": { "type": "string" },
        "airline": { "type": "string" },
        "departureAirport": { "type": "string" },
        "arrivalAirport": { "type": "string" },
        "items": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/flightItem" } }
      }
    }
  }
}
