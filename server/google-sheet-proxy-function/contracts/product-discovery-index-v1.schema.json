{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golfjoin.local/contracts/product-discovery-index-v1.schema.json",
  "title": "GolfJoin product discovery index v1",
  "type": "object",
  "required": ["schema", "generatedAt", "sourceGeneratedAt", "discoveryRevision", "range", "eventCount", "monthCount", "regionCount", "months", "regions"],
  "properties": {
    "schema": { "const": "secret-golf-join-product-discovery-index-v1" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "sourceGeneratedAt": { "type": "string", "minLength": 1 },
    "discoveryRevision": { "type": "string", "pattern": "^gpd_[a-f0-9]{24}$" },
    "range": { "$ref": "#/$defs/range" },
    "eventCount": { "type": "integer", "minimum": 1 },
    "monthCount": { "type": "integer", "minimum": 1 },
    "regionCount": { "type": "integer", "minimum": 0 },
    "months": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["month", "range", "count", "regions", "objectName", "url", "sha256", "rawBytes"],
        "properties": {
          "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
          "range": { "$ref": "#/$defs/range" },
          "count": { "type": "integer", "minimum": 1 },
          "regions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "objectName": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "rawBytes": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "count", "months"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "count": { "type": "integer", "minimum": 1 },
          "months": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" } }
        }
      }
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "required": ["startDate", "endDate"],
      "properties": {
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" }
      }
    }
  }
}
