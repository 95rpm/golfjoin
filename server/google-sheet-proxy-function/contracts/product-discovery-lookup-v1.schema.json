{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golfjoin.local/contracts/product-discovery-lookup-v1.schema.json",
  "title": "GolfJoin direct product discovery lookup v1",
  "type": "object",
  "required": ["schema", "generatedAt", "sourceGeneratedAt", "discoveryRevision", "count", "items"],
  "properties": {
    "schema": { "const": "secret-golf-join-product-discovery-lookup-v1" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "sourceGeneratedAt": { "type": "string", "minLength": 1 },
    "discoveryRevision": { "type": "string", "pattern": "^gpd_[a-f0-9]{24}$" },
    "count": { "type": "integer", "minimum": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "goodSeq", "eventSeq", "month"],
        "properties": {
          "key": { "type": "string", "minLength": 3 },
          "goodSeq": { "type": "string", "pattern": "^\\d+$" },
          "eventSeq": { "type": "string", "minLength": 1 },
          "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" }
        }
      }
    }
  }
}
