{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golfjoin.local/contracts/product-discovery-month-v1.schema.json",
  "title": "GolfJoin monthly product discovery shard v1",
  "type": "object",
  "required": ["schema", "generatedAt", "sourceGeneratedAt", "discoveryRevision", "month", "range", "count", "items"],
  "properties": {
    "schema": { "const": "secret-golf-join-product-discovery-month-v1" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "sourceGeneratedAt": { "type": "string", "minLength": 1 },
    "discoveryRevision": { "type": "string", "pattern": "^gpd_[a-f0-9]{24}$" },
    "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "range": {
      "type": "object",
      "required": ["startDate", "endDate"],
      "properties": {
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" }
      }
    },
    "count": { "type": "integer", "minimum": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["goodSeq", "eventSeq", "title", "departureDate", "returnDate", "price"],
        "properties": {
          "goodSeq": { "type": "string", "pattern": "^\\d+$" },
          "eventSeq": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "departureDate": { "type": "string", "format": "date" },
          "returnDate": { "type": "string", "format": "date" },
          "price": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  }
}
