{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golfjoin.local/contracts/schedule-participant-summary-v1.schema.json",
  "title": "GolfJoin schedule participant summary",
  "type": "object",
  "required": [
    "scheduleId",
    "sourceApplicationId",
    "title",
    "capacity",
    "creatorPeople",
    "joinedPeople",
    "confirmedPeople",
    "pendingPeople",
    "cancelledPeople",
    "remainingSeats",
    "participantNames",
    "genderSummary",
    "status",
    "approvalStatus",
    "displayStatus"
  ],
  "properties": {
    "scheduleId": { "type": "string", "minLength": 1 },
    "sourceApplicationId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "capacity": { "type": "integer", "minimum": 1 },
    "creatorPeople": { "type": "integer", "minimum": 0 },
    "joinedPeople": { "type": "integer", "minimum": 0 },
    "confirmedPeople": { "type": "integer", "minimum": 0 },
    "pendingPeople": { "type": "integer", "minimum": 0 },
    "cancelledPeople": { "type": "integer", "minimum": 0 },
    "remainingSeats": { "type": "integer", "minimum": 0 },
    "participantNames": { "type": "string" },
    "participantPhones": { "type": "string" },
    "genderSummary": { "type": "string" },
    "ageSummary": { "type": "string" },
    "levelSummary": { "type": "string" },
    "styleSummary": { "type": "string" },
    "memberPreferenceSummary": { "type": "string" },
    "status": { "type": "string", "minLength": 1 },
    "approvalStatus": { "type": "string", "minLength": 1 },
    "displayStatus": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string" }
  }
}
